{
  "name": "web-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/client",
    "dev:server": "npm run dev -w packages/server",
    "dev:all": "npm run dev:server & npm run dev",
    "build": "npm run build -w packages/shared && npm run build -w packages/server && npm run build -w packages/client",
    "build:shared": "npm run build -w packages/shared",
    "build:server": "npm run build -w packages/server",
    "build:client": "npm run build -w packages/client",
    "test": "npm run test --workspaces --if-present",
    "clean": "rimraf packages/*/dist"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "rimraf": "^6.0.0"
  }
}
