{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SpriteSchema",
    "description": "Schema for storing sprite names into groups with their matching indices",
    "type": "object",
    "properties": {
        "groups": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Group name"
                    },
                    "sprites": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "description": "Sprite name"
                                },
                                "index": {
                                    "type": "integer",
                                    "description": "Sprite index"
                                }
                            },
                            "required": ["name", "index"]
                        }
                    }
                },
                "required": ["name", "sprites"]
            }
        }
    },
    "required": ["groups"]
}